# Copy to .env. Default demo works without database access. Never commit .env.
VITE_DATA_MODE=demo
APP_ORIGIN=http://127.0.0.1:5173
PORT=8787
HOST=127.0.0.1
# NODE_ENV=production belongs on the deployed server only (Vercel or the container). It enables the
# runtime-role and HTTPS startup checks. Leave it unset for local development.
# Check a deployment value set offline with: npm run launch:preflight -- --env-file <path>

# Only for a live local API. Use a pooled, restricted-role Neon URL for deployment.
# pglite:.local/reunir is a persistent embedded PostgreSQL development alternative.
DATABASE_URL=
# Administrative direct URL, local/CI migration job ONLY. Never set this on Vercel.
MIGRATION_DATABASE_URL=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Two-step sign-in for owners and administrators: required or optional. Unset means required when NODE_ENV=production,
# optional otherwise. When required, owner and administrator tools refuse an account without two-step sign-in turned on.
ADMIN_TWO_FACTOR=
# The one request header your host's proxy overwrites with the visitor's address. Sign-in and invitation limits key on
# it. Unset means x-real-ip, which Vercel sets. Never name a header visitors can set themselves.
TRUSTED_IP_HEADER=
# Email confirmation: required or optional. Unset means required when NODE_ENV=production, optional otherwise. When
# required, an address must be confirmed by a link before it signs in; production then also needs RESEND_API_KEY and
# EMAIL_FROM. Invitations confirm the invited address as they are accepted.
EMAIL_VERIFICATION=

# CLI-only provisioning. Remove passwords after use. No seeded production users.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
COMMUNITY_SLUG=code-black
COMMUNITY_NAME=Code Black
COMMUNITY_ID=
DB_RUNTIME_PASSWORD=
ALLOW_FICTIONAL_SEED=no

# Optional Google Cloud Storage. This is NOT Google Drive.
# Prefer application default credentials / workload identity to exported key files.
GCS_BUCKET=
GCS_CREDENTIALS_JSON=
# Optional: switch on uploaded lesson video, up to this many MB per file (1 to 500). Unset or 0 keeps it off.
LESSON_VIDEO_MAX_MB=

# Virus scanning of uploads with ClamAV's clamd, reached over TCP on a private network only (never the public internet).
# UPLOAD_SCANNING: required or optional. Unset means required when NODE_ENV=production, optional otherwise. When required
# and GCS_BUCKET is set, the server will not start without CLAMAV_HOST. Check a configured scanner with npm run scan:check.
# Since Alpha 42 the API never connects to clamd: CLAMAV_HOST switches scanning on, and npm run scan:worker, run beside
# clamd with the same DATABASE_URL and bucket, does the scanning. SCAN_WORKER_IDLE_MS is its idle poll (default 3000).
UPLOAD_SCANNING=
CLAMAV_HOST=
CLAMAV_PORT=3310
SCAN_WORKER_IDLE_MS=

# Optional transactional email, server-side only. Verify the sender with the provider.
RESEND_API_KEY=
EMAIL_FROM=
# Stable independent random key (32+ characters). Changing it breaks pending encrypted mail.
EMAIL_ENCRYPTION_KEY=
# Protects GET /api/internal/mail and GET /api/internal/digests. Configure a scheduler separately; no cron is started automatically.
CRON_SECRET=
