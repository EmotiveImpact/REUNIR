{
  "name": "reunir",
  "version": "0.39.0-alpha.1",
  "description": "Purposeful communities. People, purpose, progress, projects and proof.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "node --import tsx --import ./scripts/env.ts --watch apps/api/src/server.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "db:owner": "tsx scripts/database.ts owner",
    "start": "node --import tsx --import ./scripts/env.ts apps/api/src/server.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "bundle:preview": "vite build --config apps/web/vite.config.ts --mode standalone && tsx scripts/bundle-preview.ts",
    "test:browser": "tsx scripts/browser-check.ts && tsx scripts/purpose-browser-check.ts && tsx scripts/pilot-browser-check.ts",
    "db:member": "tsx scripts/database.ts member",
    "db:runtime-role": "tsx scripts/database.ts runtime-role",
    "db:check": "tsx scripts/database.ts check",
    "db:grant-runtime": "tsx scripts/database.ts grant-runtime",
    "db:erase-learner": "tsx scripts/database.ts erase-learner",
    "db:prune-covers": "tsx scripts/database.ts prune-covers",
    "test:browser:purpose": "tsx scripts/purpose-browser-check.ts",
    "mail:drain": "tsx scripts/drain-mail.ts",
    "digests:queue": "tsx scripts/queue-digests.ts",
    "scan:check": "tsx scripts/scan-check.ts",
    "retention:run": "tsx scripts/apply-retention.ts",
    "test:browser:pilot": "tsx scripts/pilot-browser-check.ts",
    "test:http": "tsx scripts/pilot-http-check.ts",
    "test:browser:connected": "tsx scripts/pilot-connected-check.ts",
    "pilot:check": "tsx scripts/pilot-check.ts",
    "launch:preflight": "tsx scripts/launch-preflight.ts",
    "test:browser:operations": "tsx scripts/operations-browser-check.ts",
    "test:postgres": "tsx scripts/postgres-check.ts",
    "test:browser:work": "tsx scripts/project-work-browser-check.ts",
    "test:browser:authoring": "tsx scripts/authoring-browser-check.ts",
    "test:browser:monochrome": "tsx scripts/monochrome-browser-check.ts",
    "test:browser:v4": "tsx scripts/v4-integration-browser-check.ts",
    "test:browser:rich-lessons": "tsx scripts/rich-lessons-browser-check.ts",
    "test:browser:resources": "tsx scripts/resources-browser-check.ts",
    "test:browser:resources-connected": "tsx scripts/resources-connected-check.ts",
    "test:browser:assessments": "tsx scripts/assessments-browser-check.ts",
    "test:browser:assessments-connected": "tsx scripts/assessments-connected-check.ts",
    "test:browser:covers": "tsx scripts/covers-browser-check.ts",
    "test:browser:covers-connected": "tsx scripts/covers-connected-check.ts",
    "test:browser:instructors": "tsx scripts/instructors-browser-check.ts",
    "test:browser:instructors-connected": "tsx scripts/instructors-connected-check.ts",
    "test:browser:accounts": "tsx scripts/accounts-browser-check.ts",
    "test:browser:accounts-connected": "tsx scripts/accounts-connected-check.ts",
    "test:browser:notifications": "tsx scripts/notifications-browser-check.ts",
    "test:browser:groups": "tsx scripts/groups-browser-check.ts",
    "test:browser:states": "tsx scripts/states-browser-check.ts",
    "test:browser:appeals": "tsx scripts/appeals-browser-check.ts",
    "test:browser:evidence": "tsx scripts/evidence-history-browser-check.ts",
    "test:browser:credits": "tsx scripts/credits-browser-check.ts",
    "test:browser:curation": "tsx scripts/collections-browser-check.ts",
    "test:browser:task-files": "tsx scripts/task-files-browser-check.ts",
    "test:browser:forms": "tsx scripts/forms-browser-check.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@electric-sql/pglite": "0.5.8",
    "@google-cloud/storage": "8.2.0",
    "@hono/node-server": "2.1.1",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@tailwindcss/vite": "4.1.14",
    "@tanstack/react-query": "5.103.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "lucide-react": "1.47.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "zod": "4.6.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
