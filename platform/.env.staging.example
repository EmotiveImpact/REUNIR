# Staging value set for the Vercel project. Copy to .env.staging (git-ignored), never commit the copy.
#   cp .env.staging.example .env.staging
#   npm run launch:secrets -- --env-file .env.staging     fills the three empty secrets below, values not shown
#   (replace every <fill: ...> with the real value from its provider, in your editor, not in chat)
#   npm run launch:preflight -- --env-file .env.staging   must report 0 failed before anything goes into Vercel
# Then paste the file into the Vercel project's Environment Variables page for the staging environment, mark the
# secrets sensitive, and delete the local copy or keep it only in an encrypted store. Steps: docs/STAGING_LAUNCH.md.
#
# Never add here: MIGRATION_DATABASE_URL, DB_RUNTIME_PASSWORD, BOOTSTRAP_* or ALLOW_FICTIONAL_SEED. They belong to a
# one-off local provisioning shell only, and the preflight fails if they are present.

NODE_ENV=production
VITE_DATA_MODE=live

# The staging address with no path, for example https://ferven-staging.vercel.app
APP_ORIGIN=<fill: https://staging-hostname>

# Neon POOLED host (contains -pooler), user reunir_app, the runtime password you generated (LAUNCH_RUNBOOK.md section 3).
DATABASE_URL=<fill: postgresql://reunir_app:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/reunir?sslmode=require>

# Generated by npm run launch:secrets. Leave empty here; each must differ from the others.
BETTER_AUTH_SECRET=
EMAIL_ENCRYPTION_KEY=
CRON_SECRET=

ADMIN_TWO_FACTOR=required
EMAIL_VERIFICATION=required

# Resend: a sending-only key restricted to the verified REUNIR sending subdomain (LAUNCH_RUNBOOK.md section 7).
RESEND_API_KEY=<fill: re_...>
EMAIL_FROM=Ferven <fill: pilot@mail.your-domain>

# Uploads stay off for the first staging round (decision 046): no bucket, so nothing needs a virus scanner yet.
# When storage is added, set GCS_BUCKET and GCS_CREDENTIALS_JSON together with a scanner the API can reach.
GCS_BUCKET=
GCS_CREDENTIALS_JSON=
UPLOAD_SCANNING=required
CLAMAV_HOST=
LESSON_VIDEO_MAX_MB=0
