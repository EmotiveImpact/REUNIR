# Values for the scan worker. Copy to scan.env (git-ignored) on the scan host only; never commit or share the copy.
#   cp scan.env.example scan.env
# Replace each <fill: ...> with the same value the Vercel project uses. No sign-in, mail or scheduler secret belongs here.

# The same pooled runtime connection as Vercel: user reunir_app, never the owner role. The worker checks this at start.
DATABASE_URL=<fill: postgresql://reunir_app:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/reunir?sslmode=require>

GCS_BUCKET=<fill: bucket name>
# The service-account JSON on one line, as on Vercel.
GCS_CREDENTIALS_JSON=<fill: {"type":"service_account",...}>
